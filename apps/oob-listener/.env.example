# OOB callback listener — deploy environment (validated fail-closed at boot, §9; every var below is
# required unless marked optional). Copy to `.env` on the box and fill in. Never commit the filled file.

# The single public host the listener is reachable at. Path-token scheme (ADR-36): a callback is
# `<base>/<token>` on THIS one host — NO wildcard DNS, no domain required. With ngrok this is the
# tunnel host, e.g. `abc123.ngrok-free.app`; with your own box/domain it's e.g. `oob.example.com`.
OOB_HOST=abc123.ngrok-free.app

# The full public base URL (scheme + host) the SSRF payload embeds. Set it when the listener is fronted
# by TLS (ngrok/Cloudflare/PaaS give you https) — e.g. `https://abc123.ngrok-free.app`. Optional;
# defaults to `http://<OOB_HOST>` for a plain-HTTP box on port 80.
OOB_PUBLIC_BASE=https://abc123.ngrok-free.app

# In-container listen port. Map your public entrypoint to this (ngrok: `ngrok http 8080`; a box: `-p 80:8080`).
# Optional (default 8080).
PORT=8080

# Shared Postgres — the SAME managed instance the gateway uses (append-only audit log, ADR-16).
# The listener does NOT run migrations; the main app owns the schema, so it must already be migrated.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Shared Redis — the SAME managed instance the gateway uses. The listener WRITES the callback ledger
# and the gateway READS it, so they MUST share one Redis. An in-memory fallback would silently disable
# SSRF confirmation in a multi-process deploy (the exact silent degradation §9 forbids) — hence required.
REDIS_URL=rediss://default:pass@host:6379

# Shared bearer gating the internal control plane (POST /register, GET /callbacks/:token). It MUST equal
# the gateway's OOB_CONTROL_TOKEN. Min 16 chars — generate a long one: `openssl rand -hex 32`.
OOB_CONTROL_TOKEN=replace-with-a-long-random-secret

# Optional. One of: fatal|error|warn|info|debug|trace|silent (default info).
LOG_LEVEL=info
