---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Terms | Corvid" description="The terms that will govern use of Corvid." path="/terms">
  <Nav />
  <main id="main" tabindex="-1" class="mx-auto max-w-2xl px-6 pb-24 pt-24">
    <h1 class="text-balance text-4xl font-semibold text-chalk">Terms</h1>
    <p class="mt-6 text-pretty text-lg text-fog">
      This is a pre-launch placeholder. Corvid is not yet generally available, and no testing agreement is
      in effect through this page.
    </p>
    <p class="mt-4 text-pretty text-fog">
      Full terms of service, including the authorization and scope requirements every active test must
      satisfy, will be published before general access opens.
    </p>
  </main>
  <Footer />
</Base>
