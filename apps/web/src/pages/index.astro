---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import Benefits from '../components/Benefits.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import HowItWorks from '../components/HowItWorks.astro';
import VulnClasses from '../components/VulnClasses.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Corvid | The appsec agent that reports verified findings only"
  description="Corvid hypothesizes, tests, and verifies web-app vulnerabilities in an egress-locked sandbox, reporting a finding only after a deterministic check proves the exploit fired. Zero unverified findings."
>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <ProblemSolution />
    <Benefits />
    <TaglineReveal />
    <HowItWorks />
    <VulnClasses />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>
