---
// Coverage: four vulnerability classes, each with a real, different
// verification signal — drawn as four distinct instrument readouts in an
// alternating layout, not four identical icon+heading+text cards.
import SectionReveal from './SectionReveal.astro';
import { CHANNEL_LABEL } from '../lib/styles';

const classes = [
  {
    name: 'JWT algorithm / key confusion',
    signal: 'A provable authenticated state transition using a forged or mutated token.',
    trace: 'M0,60 L30,60 L45,32 L55,60 L70,60 L70,88 L85,60 L100,60 L112,36 L124,60 L150,60',
  },
  {
    name: 'SSRF, including blind',
    signal: 'A correlated callback received on the out-of-band listener for a unique per-test token.',
    trace: 'M0,60 L45,60 L45,20 L55,20 L55,60 M95,60 L105,60 L105,20 L115,20 L115,60 L150,60',
  },
  {
    name: 'SQL / NoSQL injection',
    signal: 'An error-based, time-based (statistically bounded), or boolean-differential signal.',
    trace: 'M0,44 L60,44 L75,44 L90,80 L105,80 L150,80',
    traceAlt: 'M0,80 L60,80 L75,80 L90,44 L105,44 L150,44',
  },
  {
    name: 'IDOR',
    signal: "One session provably reading or acting on another session's object.",
    trace: 'M0,36 L55,36 L80,84 L150,84',
    traceAlt: 'M0,84 L55,84 L80,36 L150,36',
  },
];
---

<section id="coverage" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <SectionReveal>
      <h2 class="max-w-[720px] text-balance font-display text-3xl font-semibold text-chalk sm:text-5xl">
        Four vulnerability classes, each with a real verification signal
      </h2>
    </SectionReveal>

    <div class="mt-14 divide-y divide-steel border-y border-steel">
      {
        classes.map((item, i) => (
          <SectionReveal delay={(i % 2) * 100}>
            <div
              class:list={[
                'flex flex-col gap-8 py-10 md:items-center md:gap-12',
                i % 2 === 1 ? 'md:flex-row-reverse' : 'md:flex-row',
              ]}
            >
              <svg
                viewBox="0 0 150 120"
                class="h-20 w-full shrink-0 text-steel md:h-24 md:w-56"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
              >
                <path d={item.trace} fill="none" stroke="currentColor" stroke-width="2" />
                {item.traceAlt && (
                  <path d={item.traceAlt} fill="none" stroke="var(--color-signal)" stroke-width="2" opacity="0.55" />
                )}
              </svg>
              <div class="max-w-xl">
                <p class={CHANNEL_LABEL}>CH.0{i + 1}</p>
                <h3 class="mt-2 text-xl font-semibold text-chalk sm:text-2xl">{item.name}</h3>
                <p class="mt-3 text-pretty text-fog">{item.signal}</p>
              </div>
            </div>
          </SectionReveal>
        ))
      }
    </div>
  </div>
</section>
