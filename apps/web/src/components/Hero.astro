---
// Hero: the signature moment. Oversized display type carries the emphasis —
// no gradient text (banned), no eyebrow label above the H1. The pipeline
// below the fold-line is the one extraordinary animated centerpiece.
import SectionReveal from './SectionReveal.astro';
import SignalPipeline from './SignalPipeline.astro';
import Graticule from './Graticule.astro';
import { BUTTON_PRIMARY } from '../lib/styles';
import { SIGN_UP_URL } from '../lib/config';
---

<section id="hero" class="relative overflow-hidden px-6 pb-20 pt-40 sm:pb-28 sm:pt-48">
  <Graticule class="opacity-70" opacity={0.06} />

  <div class="relative mx-auto max-w-5xl">
    <SectionReveal>
      <h1
        class="max-w-[820px] text-balance font-display text-5xl font-semibold leading-[1.05] text-chalk sm:text-7xl"
      >
        Every finding is proven.<br />Or it isn&rsquo;t a finding.
      </h1>
    </SectionReveal>

    <SectionReveal delay={100}>
      <p class="mt-8 max-w-[620px] text-pretty text-lg text-fog">
        Corvid hypothesizes where a vulnerability hides, tests it inside an egress-locked sandbox, and reports
        it only after a deterministic check proves the exploit fired.
      </p>
    </SectionReveal>

    <SectionReveal delay={200}>
      <div class="mt-10 flex flex-wrap items-center gap-5">
        <a href={SIGN_UP_URL} class={BUTTON_PRIMARY}>Get started</a>
        <p class="flex items-center gap-2 text-sm text-ash">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-signal" aria-hidden="true"></span>
          Zero unverified findings.
        </p>
      </div>
    </SectionReveal>
  </div>

  <SectionReveal delay={280}>
    <div class="relative mx-auto mt-20 max-w-5xl rounded-2xl border border-steel bg-coal/60 p-6 sm:mt-24 sm:p-10">
      <p class="font-mono text-xs tracking-wider text-ash">SIG.001 — LIVE TRACE</p>
      <div class="mt-6">
        <SignalPipeline />
      </div>
    </div>
  </SectionReveal>
</section>
