---
// Reusable scroll-reveal wrapper (skill B7). Enters with a heavy fade-up + blur,
// driven by IntersectionObserver — never a scroll listener. The no-JS visible
// fallback lives once in Base.astro's <head> (a single global .reveal
// noscript override) rather than duplicated per instance. Reduced-motion is
// handled globally in global.css.
interface Props {
  class?: string;
  /** Extra transition-delay in ms, for staggering multiple reveals in one section. */
  delay?: number;
  /** Wrapping element, e.g. "li" when nesting inside an <ol>/<ul>. Defaults to "div". */
  as?: 'div' | 'li' | 'article';
}

const { class: className = '', delay = 0, as = 'div' } = Astro.props;
const Tag = as;
---

<Tag
  class:list={['reveal', className]}
  style={delay ? `transition-delay:${delay}ms` : undefined}
>
  <slot />
</Tag>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(4rem);
    filter: blur(12px);
    transition:
      opacity 900ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 900ms cubic-bezier(0.32, 0.72, 0, 1),
      filter 900ms cubic-bezier(0.32, 0.72, 0, 1);
    will-change: opacity, transform, filter;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    will-change: auto;
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
  );

  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
