---
// Final CTA: the close mirrors the hero's stamp, not a repeat of a plain
// bordered box. Same promise, same single action as the hero.
import { Icon } from 'astro-icon/components';
import SectionReveal from './SectionReveal.astro';
import Graticule from './Graticule.astro';
import { BUTTON_PRIMARY } from '../lib/styles';
import { SIGN_UP_URL } from '../lib/config';
---

<section id="get-started" class="relative overflow-hidden px-6 py-28">
  <Graticule opacity={0.05} />
  <div class="relative mx-auto max-w-3xl text-center">
    <SectionReveal>
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border-2 border-signal">
        <Icon name="ph:seal-check" class="h-7 w-7 text-signal" aria-hidden="true" />
      </span>

      <h2 class="mx-auto mt-8 max-w-[680px] text-balance font-display text-3xl font-semibold text-chalk sm:text-5xl">
        Every finding is proven. Or it isn&rsquo;t a finding.
      </h2>
      <p class="mx-auto mt-5 max-w-[560px] text-pretty text-lg text-fog">
        Run Corvid against your first authorized target. Every active test is human approved, and every
        finding ships with the request that reproduces it.
      </p>
      <div class="mt-9 flex justify-center">
        <a href={SIGN_UP_URL} class={BUTTON_PRIMARY}>Get started</a>
      </div>
      <p class="mt-5 flex items-center justify-center gap-2 text-sm text-ash">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-signal" aria-hidden="true"></span>
        Zero unverified findings.
      </p>
    </SectionReveal>
  </div>
</section>
