---
// The proof moment: the dedicated centerpiece, distinct from the hero's live
// trace. This is the artifact a finding actually leaves behind, a
// reproducing request and a sealed verification record, not a decorative
// screenshot.
import { Icon } from 'astro-icon/components';
import SectionReveal from './SectionReveal.astro';
import { CHANNEL_LABEL } from '../lib/styles';
---

<section id="proof" class="px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <SectionReveal>
      <h2 class="max-w-[720px] text-balance font-display text-3xl font-semibold text-chalk sm:text-5xl">
        Every finding ships as a sealed record, not a screenshot
      </h2>
      <p class="mt-6 max-w-[620px] text-pretty text-lg text-fog">
        No summary, no severity guess. The reproducing request, the response that proves it, and the signal
        that fired, together, or there is no finding at all.
      </p>
    </SectionReveal>

    <SectionReveal delay={120}>
      <div class="relative mt-14 grid gap-px overflow-hidden border border-steel bg-steel md:grid-cols-[1.4fr_1fr]">
        <div class="bg-coal p-8 sm:p-10">
          <p class={CHANNEL_LABEL}>REQ / RES — jwt.alg_confusion</p>
          <pre class="mt-4 overflow-x-auto font-mono text-sm leading-relaxed text-fog"><code
            >PUT /api/session HTTP/1.1
Host: target.example
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9...
X-Corvid-Test: jwt.alg_confusion#7f3a

<span class="text-ash">HTTP/1.1 200 OK</span>
<span class="text-ash">X-Auth-Subject: user:admin-not-you</span> <span class="cursor-blink text-signal" aria-hidden="true">▍</span></code></pre>
          <p class="mt-6 text-pretty text-fog">
            The public key, meant only to verify RS256 signatures, was accepted as an HS256 secret. The forged
            token authenticated as a different account.
          </p>
        </div>

        <div class="flex flex-col justify-between gap-8 bg-graphite p-8 sm:p-10">
          <div>
            <p class={CHANNEL_LABEL}>VERIFICATION SIGNAL</p>
            <p class="mt-3 text-pretty text-fog">
              A deterministic, non LLM check confirmed the auth state transition. The model that proposed this
              test never touches the verdict.
            </p>
          </div>

          <div class="flex items-center gap-4">
            <span class="seal-badge flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-2 border-signal">
              <Icon name="ph:seal-check" class="h-9 w-9 text-signal" aria-hidden="true" />
            </span>
            <div>
              <p class="text-lg font-semibold text-chalk">Proven</p>
              <p class="text-sm text-ash">2026-08-15T09:42:11Z</p>
            </div>
          </div>
        </div>
      </div>
    </SectionReveal>
  </div>
</section>

<style>
  /* Real depth, not a halo: an offset, downward shadow, as if the seal casts
     light onto the panel beneath it, never a symmetric decorative ring. */
  .seal-badge {
    box-shadow: 0 12px 28px -12px rgba(255, 178, 56, 0.5);
    transform: rotate(-6deg);
  }

  .cursor-blink {
    animation: cursor-blink 1.1s step-end infinite;
  }
</style>
