---
// Mandatory tagline reveal (skill B11): its own moment, not stacked under the
// hero. Words start muted and light up one at a time, in reading order, as
// they cross a trigger line, via per-word IntersectionObserver.
import SectionReveal from './SectionReveal.astro';

const lines = [
  "We don't cry wolf.",
  'Every vulnerability Corvid reports comes with the exact request that proves it, nothing you have to take on faith.',
];
---

<section class="px-6 py-24">
  <div class="mx-auto max-w-4xl">
    <SectionReveal>
      <p class="max-w-[680px] text-balance text-4xl font-semibold leading-snug text-chalk sm:text-5xl lg:text-6xl">
        {
          lines.map((line) => (
            <span class="block">
              {line.split(' ').map((word, wordIndex) => (
                <>
                  <span class="tagline-word" style={`transition-delay:${Math.min(wordIndex, 10) * 45}ms`}>
                    {word}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </p>
    </SectionReveal>
  </div>
</section>

<style>
  .tagline-word {
    opacity: 0.3;
    transition: opacity 700ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .tagline-word.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tagline-word {
      opacity: 1;
    }
  }
</style>

<noscript>
  <style>
    .tagline-word {
      opacity: 1 !important;
    }
  </style>
</noscript>

<script>
  const words = document.querySelectorAll<HTMLElement>('.tagline-word');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-active');
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.6, rootMargin: '0px 0px -35% 0px' },
  );
  words.forEach((word) => io.observe(word));
</script>
